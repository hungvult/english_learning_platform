# ==============================================================================
# English Learning Platform - Environment Configuration Template
# Copy this file to .env and adjust values as needed for your environment.
# ==============================================================================

# ── SQL Server 2022 Configuration ──────────────────────────────────────────────
SA_PASSWORD=YourStrong!Passw0rd
DB_NAME=EnglishLearning
DB_SERVER=sqlserver
DB_PORT=1433
DB_COLLATION=Latin1_General_100_CI_AI_SC_UTF8
# Minimum 2048 MB required by SQL Server 2022 engine; do not reduce below 2000
MSSQL_MEMORY_LIMIT_MB=2048

# ── Backend (FastAPI) Configuration ───────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Database URL constructed using the variables above:
DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@sqlserver:1433/EnglishLearning?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Client (Next.js) Configuration ────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
# Browser-side API URL (accessed from client machine)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Internal Docker network API URL (used by Next.js Server Components during SSR)
INTERNAL_API_URL=http://backend:8000
